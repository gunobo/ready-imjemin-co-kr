# docker compose가 읽는 환경변수. 이 파일을 .env로 복사한 뒤 실제 값을 채우세요.
# .env는 절대 git에 커밋하지 마세요.

# JWT 서명 비밀키 (긴 무작위 문자열로 변경)
JWT_SECRET=change-this-to-a-long-random-string

# 최초 관리자 계정
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-this-password

# Cloudflare Tunnel 토큰 (Cloudflare Zero Trust 대시보드에서 발급)
CLOUDFLARE_TUNNEL_TOKEN=

# 학생 구글 로그인용 OAuth Client ID (xxxx.apps.googleusercontent.com 형태, 비밀값 아님)
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)에서 발급.
# Authorized JavaScript origins에 https://ready.imjemin.co.kr 를 등록해야 함.
# 비워두면 학생 로그인 버튼이 "아직 설정되지 않았습니다"로 표시됨 (관리자 로그인은 영향 없음).
GOOGLE_CLIENT_ID=
